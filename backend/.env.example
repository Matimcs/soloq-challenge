# Copia este archivo como .env y rellena los valores.

# Cadena de conexión de Postgres (Supabase → Project Settings → Database → Connection string → "Session pooler" / URI).
# Reemplaza [YOUR-PASSWORD] por la contraseña de tu base.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres

# Secreto para firmar los JWT (pon una cadena larga y aleatoria).
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Secreto para la ingesta del ranking (el runner local lo usa para empujar
# players.json al server online). Debe coincidir con el INGEST_URL del runner.
INGEST_SECRET=cambia-esto-por-otra-cadena-larga-y-aleatoria

# Puerto (opcional, por defecto 8123).
# PORT=8123
