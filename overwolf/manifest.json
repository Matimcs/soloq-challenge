{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "SoloQ Challenge Overlay",
    "author": "SoloQ Chile",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.200.0",
    "description": "Overlay in-game del torneo SoloQ Challenge (se inyecta en League como Porofessor, por lo que se ve al compartir la ventana en Discord).",
    "icon": "icons/icon.png",
    "icon_gray": "icons/icon_gray.png",
    "dock_button_title": "SoloQ"
  },
  "permissions": ["Hotkeys", "GameInfo"],
  "data": {
    "start_window": "background",
    "game_targeting": { "type": "dedicated", "game_ids": [5426] },
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [5426] },
        "start_minimized": true
      }
    ],
    "hotkeys": {
      "sqc_toggle": {
        "title": "Mostrar/ocultar overlay SoloQ",
        "action-type": "custom",
        "default": "Alt+X"
      }
    },
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true
      },
      "ingame": {
        "file": "ingame.html",
        "in_game": true,
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "clickthrough": false,
        "focus_game_takeover": "ReleaseOnHidden",
        "keep_window_location": true,
        "size": { "width": 360, "height": 168 },
        "start_position": { "top": 20, "left": 20 }
      }
    }
  }
}
