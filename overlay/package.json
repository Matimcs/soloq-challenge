{
  "name": "sqc-overlay",
  "version": "0.2.1",
  "description": "SoloQ Challenge overlay (sin Overwolf) — Electron + APIs locales de Riot",
  "author": "SoloQ Chile",
  "main": "main.js",
  "scripts": {
    "prestart": "node -e \"require('fs').copyFileSync('../roulette.js','roulette.js')\"",
    "start": "electron .",
    "predist": "node -e \"require('fs').copyFileSync('../roulette.js','roulette.js')\"",
    "dist": "electron-builder --win nsis",
    "prepublish-app": "node -e \"require('fs').copyFileSync('../roulette.js','roulette.js')\"",
    "publish-app": "node -e \"require('fs').copyFileSync('../roulette.js','roulette.js')\" && electron-builder --win nsis --publish always",
    "probe": "node probe.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "gg.soloqchallenge.overlay",
    "productName": "SoloQ Overlay",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Matimcs",
        "repo": "soloq-challenge"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "SoloQ-Overlay-Setup-${version}.${ext}"
    }
  }
}
